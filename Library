                                    and OpenFrame.IsOpen
                                    and OpenFrame.Frame
                                    and OpenFrame.Frame:IsMouseOverFrame()
                                then
                                    return
                                end
                            end

                            Settingss:SetOpen(false)
                        end
                    end
                end)

                return setmetatable(Settingss, Library)
            end

