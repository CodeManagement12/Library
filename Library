    local function GetKeyDisplay(Key)
        local Name = tostring(Key or "")
        Name = Name:gsub("^Enum%.KeyCode%.", ""):gsub("^Enum%.UserInputType%.", "")
        return KeyNames[Name] or Name
    end

    local function IsKeybindPressed(Input, Key)
        if not Input or Key == nil then
            return false
        end

        local KeyString = tostring(Key)

        if tostring(Input.KeyCode) == KeyString or tostring(Input.UserInputType) == KeyString then
            return true
        end

        if Input.UserInputType == Enum.UserInputType.MouseWheel then
            local Delta = Input.Position.Z
            return (KeyString == "MouseWheelUp" and Delta > 0) or (KeyString == "MouseWheelDown" and Delta < 0)
        end

        return false
    end

