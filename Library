                    TextXAlignment = Enum.TextXAlignment.Left,
                    Position = UDim2.new(0, 100, 0, 30),
                    BorderSizePixel = 0
                }):AddToTheme({ TextColor3 = 'Text' })
            end

            Library:RegisterLayout("TargetIndicator", {
                Instance = Items["TargetIndicator"].Instance
            })

            Indicator:Center()

            return Indicator
        end

